#include <stdio.h>
 
int main() {
 
 int x[10];
    int i=0;
    for(i = 0 ; i<10 ;i++){
        x[i]=i;
        scanf("%d",&x[i]);
     
     } 
      for(i = 0 ; i<10 ; i++){
          if(x[i] <= 0){
           x[i] = 1;
          printf("x[%d] = %d \n",i,x[i]);
     }else{
    printf("x[%d] = %d\n",i,x[i]);
     }
      }
    return 0;
}
        
