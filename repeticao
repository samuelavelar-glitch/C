#include <stdio.h>

int main() {
    int numero, vezes , i=0 , pares=0 , impares=0;
         printf("Digite um numero de vezes: ");
          scanf("%d", &vezes);
        for(i=0 ; i<vezes; i++){
            printf("Digite um numero inteiro: ");
            scanf("%d", &numero);
      
      
            if ( numero % 2 == 0 ) {
                pares++;
  
              }  else {
                impares++;
          
            }   
         }
             printf("\nTotal de pares eh %d",pares);
       
            printf("\nTotal de impares eh %d",impares);
     
      return 0;
  }
