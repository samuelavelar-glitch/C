#include <stdio.h>
 
int main() {
 
    int n1=0 , n2=0 , i=0 ,soma=0, temp;
    
     scanf("%d %d", &n1 , &n2);
 
     if(n1 > n2){
          temp = n1;
          n1 = n2;
          n2 = temp;
     }
     for(i = n1 ; i<=n2 ; i++){
         
        
         if(i % 13 != 0 ){
             soma+= i;
                 }  
                
     }
       printf("%d\n",soma);  
    return 0;
}
