#include <stdio.h>

int main() {
     int  i , x , y , n , j , soma=0;
      int temp;

      scanf("%d",&n);

       for(i = 0 ; i<n ; i++){
           scanf("%d %d",&x , &y);

           if(x > y){
            temp = x;
             x = y;
             y = temp;

           }
             soma=0;
                for(j = x + 1 ; j <y ; j++){

                if(j % 2 == 1){
                   soma+=j;

                }

            }

            printf("%d\n",soma);
       }


    return 0;
}
