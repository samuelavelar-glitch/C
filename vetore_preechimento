#include <stdio.h>

int main() {
    int i, n[10];
    
    for(i = 0; i < 10; i++) {
        scanf("%d", &n[i]);
    }
    
    for(i = 0; i < 10; i++) {
        if(n[i] <= 50) {
            printf("N[%d] = %d\n", i, n[i] * 2);
        } else {
            printf("N[%d] = %d\n", i, n[i]);
        }
    }
    
    return 0;
}
