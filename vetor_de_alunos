#include <stdio.h>
#include <stdlib.h>

int main(){
    int n;
    scanf("%d", &n);
    
    float notas[n];
    float soma = 0;
    
    for(int i = 0; i < n; i++){
        scanf("%f", &notas[i]);
        soma += notas[i];
    }

    float media = soma / n;
    printf("\nMedia da turma: %.2f\n\n", media);

    for(int i = 0; i < n; i++){
        if(notas[i] > media){
            printf("O aluno %d ficou acima da media com a nota %.2f\n", i + 1, notas[i]);
        }
    }

    return 0;
}
