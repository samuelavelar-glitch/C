//// fibonaci ////
#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    unsigned long long fib[61];
    fib[0] = 0;
    fib[1] = 1;

    for (int i = 2; i <= 60; i++) {
        fib[i] = fib[i - 1] + fib[i - 2];
    }

    int vr[n];
    for (int i = 0; i < n; i++) {
        scanf("%d", &vr[i]);
    }

    for (int i = 0; i < n; i++) {
        printf("Fib(%d) = %llu\n", vr[i], fib[vr[i]]);
    }

    return 0;
}
