#include <stdio.h>
 
    int main() {
     
        char operacao;
        double mat[12][12] ,soma=0;
        int l=0 ;
        
        scanf("%d",&l);
        scanf(" %c",&operacao);
      
       for(int i = 0 ; i <12 ; i++){
         
          for(int j = 0 ; j <12 ; j++){
         
              scanf("%lf",&mat[i][j]);
          
             if(i == l){
                 soma+=mat[i][j];
             }
        
          }
      
       }
         if(operacao == 'S'){
           printf("%.1lf\n",soma);
         }
         else if(operacao == 'M') {
             soma = soma/12.0;
             printf("%.1lf\n",soma);
         }
 
    return 0;
}
