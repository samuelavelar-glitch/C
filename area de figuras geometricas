#include <stdio.h>

int main() {
     double a , b , c ,triangulo , circulo, trap , quadrado , retangulo;
         scanf("%lf",&a);
          scanf("%lf",&b);
         scanf("%lf",&c);
      triangulo = a*c/2;
      circulo = c*c*3.14159;
        trap = (a+b)*c/2;
        quadrado = b*b;
        retangulo = a*b;
        printf("TRIANGULO: %.3lf\n",triangulo);
        printf("CIRCULO: %.3lf\n",circulo);
        printf("TRAPEZIO: %.3lf\n",trap);
        printf("QUADRADO: %.3lf\n",quadrado);
        printf("RETANGULO: %.3lf\n",retangulo);

    return 0;
}
