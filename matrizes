#include <stdio.h>

int main()
{
    int A[2][2]={
        {7,8},
        {8,7}  
    };
    int B[2][2]={
        {5,9},
        {4,3}  
    };
    int soma[2][2];
    for(int i=0 ; i<2; i++){
        for(int j=0 ; j<2; j++){
